*.dta
*.sav
*.rds
*.RData
*.zip
*.gz
*.tar
*.7z
*.bz2
*.xz

# Analysis output directories - derived data, regenerated by the notebooks.
# Covers every artifact inside them (parquet, graphml, written reports with usernames).
*_output/

# Python bytecode
__pycache__/
*.pyc

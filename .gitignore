# Credentials — never commit
.env
.env.*
!.env.example

# Collected data — never commit. Regenerate from the notebooks instead.
data/
Old Data/
*.pickle
*.pkl
*.parquet
*.csv
*.xls
*.xlsx

# Jupyter
.ipynb_checkpoints/

# Caliber local state
.caliber/

# Derived data — never commit
*.graphml
p2_data_cleaning/pipeline_scripts_2026-09/*.json
p2_data_cleaning/pipeline_scripts_2026-09/*.html

# Figures stay local (username labels); regenerate from the notebooks
p2_figures/

# Any other data format - the rule is: data stays local, code is committed
*.tsv
*.jsonl
*.ndjson
*.feather
*.arrow
*.parq
*.orc
*.avro
*.h5
*.hdf5
*.npy
*.npz
*.db
*.sqlite
